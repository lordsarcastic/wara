# Core app
APP_ENV=development
WARA_CONFIG_FILE=
BIND_ADDR=0.0.0.0:8080
BACKEND_PORT=8080
FRONTEND_PORT=4200
WARA_SECRET_KEY=replace-with-a-long-random-secret
# Schema is applied by `wara-migrate migration apply` (see README). This dev-only
# escape hatch lets Toasty regenerate the schema directly while iterating on
# models; leave false outside of local model iteration.
WARA_DB_PUSH_SCHEMA=false
WARA_DOCS_ENABLED=true
WARA_REMOTE_SERVICES_ROOT=/opt/wara/services
WARA_DOCKERFILE_CONTEXT_DIR=context
WARA_JWT_PRIVATE_KEY_PEM=
WARA_JWT_PUBLIC_KEY_PEM=
WARA_JWT_ISSUER=wara
WARA_JWT_AUDIENCE=wara-api
WARA_JWT_ACCESS_TOKEN_TTL_SECONDS=900
WARA_APP_BASE_URL=http://localhost:4200
WARA_INVITE_TOKEN_TTL_SECONDS=604800
WARA_BOOTSTRAP_ADMIN_EMAIL=admin@wara.local
WARA_BOOTSTRAP_ADMIN_PASSWORD=change-me
WARA_BOOTSTRAP_ADMIN_NAME=Wara Admin

# Wara PostgreSQL
POSTGRES_USER=wara
POSTGRES_PASSWORD=wara
POSTGRES_DB=wara
POSTGRES_PORT=5432
DATABASE_URL=postgres://wara:wara@localhost:5432/wara

# Platform telemetry, disabled by default
WARA_TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=wara-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Temporal client settings used by backend and workers
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_NAMESPACES=default

# Temporal deployment settings
TEMPORAL_VERSION=1.30.1
TEMPORAL_UI_VERSION=2.34.0
TEMPORAL_POSTGRESQL_VERSION=16
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal
TEMPORAL_POSTGRES_PORT=5432
TEMPORAL_FRONTEND_PORT=7233
TEMPORAL_UI_PORT=8081
TEMPORAL_UI_CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Optional local observability stack
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
JAEGER_GRPC_PORT=4317
JAEGER_HTTP_PORT=4318
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=changeme
ELASTIC_PORT=9200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Tests only
WARA_TEST_DATABASE_URL=postgres://wara:wara@localhost:5432/wara

# The backend also reads ~/.wara/config.yml. Set WARA_CONFIG_FILE to point at
# a different file. Environment variables override file values and are what the
# Docker Compose deployment injects by default.
